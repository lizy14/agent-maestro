{
  "name": "agent-maestro",
  "displayName": "Agent Maestro",
  "description": "Turn VS Code into your compliant AI playground! With Agent Maestro, spin up Cline or Roo on demand and plug Claude Code, Codex, Gemini CLI, or CodeBuddy / WorkBuddy straight in through an OpenAI/Anthropic/Gemini-compatible API.",
  "version": "2.14.1",
  "icon": "assets/icons/icon.png",
  "publisher": "Joouis",
  "repository": "https://github.com/Joouis/agent-maestro",
  "engines": {
    "vscode": "^1.120.0",
    "node": ">=22"
  },
  "packageManager": "pnpm@11.9.0",
  "categories": [
    "AI",
    "Chat",
    "Data Science",
    "Debuggers",
    "Extension Packs",
    "Programming Languages",
    "Education",
    "Snippets",
    "Testing",
    "Other"
  ],
  "keywords": [
    "cline",
    "roo-code",
    "kilocode",
    "vibe coding",
    "developer",
    "mcp",
    "coding",
    "agent",
    "autonomous",
    "ai",
    "github copilot",
    "anthropic",
    "claude code",
    "claude",
    "openai",
    "codex",
    "gpt",
    "gemini",
    "gemini cli",
    "proxy",
    "api"
  ],
  "type": "module",
  "main": "./dist/extension.cjs",
  "contributes": {
    "configuration": {
      "type": "object",
      "title": "Agent Maestro Configuration",
      "properties": {
        "agent-maestro.rooVariantIdentifiers": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "kilocode.kilo-code"
          ],
          "description": "List of extension identifiers that are considered Roo variants (need restart to take effect)",
          "scope": "application"
        },
        "agent-maestro.defaultRooIdentifier": {
          "type": "string",
          "default": "rooveterinaryinc.roo-cline",
          "description": "Default Roo extension identifier to use when multiple variants are available (need restart to take effect)"
        },
        "agent-maestro.proxyServerPort": {
          "type": "number",
          "default": 23333,
          "description": "Port for the Agent Maestro proxy server (need restart to take effect)"
        },
        "agent-maestro.mcpServerPort": {
          "type": "number",
          "default": 23334,
          "description": "Port for the Agent Maestro MCP server (need restart to take effect)"
        },
        "agent-maestro.allowOutsideWorkspaceAccess": {
          "type": "boolean",
          "default": false,
          "description": "Allow the extension to access files outside of the current workspace",
          "scope": "application"
        },
        "agent-maestro.fallbackModelId": {
          "type": "string",
          "default": "",
          "description": "Model ID to use when a requested model is unavailable after exact and fuzzy matching. Leave empty to use VS Code's automatic model fallback.",
          "scope": "application"
        },
        "agent-maestro.usage.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Record local model-call metrics for the usage dashboard. Stores no prompts, response content, credentials, or tool arguments.",
          "scope": "application"
        },
        "agent-maestro.usage.priceOverrides": {
          "type": "object",
          "default": {},
          "scope": "application",
          "description": "Exact model ID to USD per million text tokens. Estimates only; use your BYOK rates. Required input/output, optional cacheRead/cacheWrite. Overrides replace catalog rates.",
          "additionalProperties": {
            "type": "object",
            "required": [
              "input",
              "output"
            ],
            "additionalProperties": false,
            "properties": {
              "input": {
                "type": "number",
                "minimum": 0
              },
              "output": {
                "type": "number",
                "minimum": 0
              },
              "cacheRead": {
                "type": "number",
                "minimum": 0
              },
              "cacheWrite": {
                "type": "number",
                "minimum": 0
              }
            }
          }
        },
        "agent-maestro.usage.priceAliases": {
          "type": "object",
          "default": {},
          "scope": "application",
          "description": "Explicit exact model ID aliases for usage cost estimates. No fuzzy matching; unknown models remain unpriced.",
          "additionalProperties": {
            "type": "string"
          }
        },
        "agent-maestro.usage.autoSessionNames": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "description": "Automatically resolve Codex session names from session_index.jsonl in Codex Home, CODEX_HOME, or ~/.codex. Reads only ID/title metadata on the extension host; no credentials or transcripts. Disable to stop automatic discovery; manual imports are managed separately."
        },
        "agent-maestro.usage.codexHome": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Optional absolute Codex home directory for automatic session names. Empty uses CODEX_HOME or ~/.codex on this extension host. For remote/container hosts, use a read-only mounted metadata directory. No recursive search is performed."
        },
        "agent-maestro.usage.githubCredits.enabled": {
          "type": "boolean",
          "default": false,
          "scope": "application",
          "description": "Poll official GitHub AI-credit billing usage via existing GitHub CLI login every 30 minutes while the dashboard is visible. No login scopes are changed. Only usage totals are stored locally. Organization-managed plans require organization billing access."
        },
        "agent-maestro.usage.githubCredits.scope": {
          "type": "string",
          "enum": [
            "user",
            "organization"
          ],
          "default": "user",
          "scope": "application",
          "description": "Billing scope. User applies only to a personally billed Copilot plan; organization requires administrator billing permissions."
        },
        "agent-maestro.usage.githubCredits.organization": {
          "type": "string",
          "default": "",
          "scope": "application",
          "description": "Organization login for organization-scoped GitHub AI-credit usage."
        },
        "agent-maestro.usage.githubCredits.monthlyAllowance": {
          "type": "number",
          "minimum": 0,
          "default": 0,
          "scope": "application",
          "description": "Known monthly allowance in AI credits for the selected billing scope, entered by you. GitHub usage API does not expose quota. Zero means unknown; percentages and month-end over/under projection remain unavailable."
        }
      }
    },
    "commands": [
      {
        "command": "agent-maestro.getStatus",
        "title": "Get Extensions Status",
        "category": "Agent Maestro"
      },
      {
        "command": "agent-maestro.startProxyServer",
        "title": "Start API Server",
        "category": "Agent Maestro"
      },
      {
        "command": "agent-maestro.stopProxyServer",
        "title": "Stop API Server",
        "category": "Agent Maestro"
      },
      {
        "command": "agent-maestro.restartProxyServer",
        "title": "Restart API Server",
        "category": "Agent Maestro"
      },
      {
        "command": "agent-maestro.getProxyServerStatus",
        "title": "Get API Server Status",
        "category": "Agent Maestro"
      },
      {
        "command": "agent-maestro.startMcpServer",
        "title": "Start MCP Server",
        "category": "Agent Maestro"
      },
      {
        "command": "agent-maestro.stopMcpServer",
        "title": "Stop MCP Server",
        "category": "Agent Maestro"
      },
      {
        "command": "agent-maestro.getMcpServerStatus",
        "title": "Get MCP Server Status",
        "category": "Agent Maestro"
      },
      {
        "command": "agent-maestro.installMcpConfig",
        "title": "Install MCP Configuration",
        "category": "Agent Maestro"
      },
      {
        "command": "agent-maestro.configureClaudeCode",
        "title": "Configure Claude Code Settings",
        "category": "Agent Maestro"
      },
      {
        "command": "agent-maestro.configureClaudeDesktop",
        "title": "Configure Claude Desktop Settings",
        "category": "Agent Maestro"
      },
      {
        "command": "agent-maestro.configureCodex",
        "title": "Configure Codex Settings",
        "category": "Agent Maestro"
      },
      {
        "command": "agent-maestro.configureDsh",
        "title": "Configure DSH Settings",
        "category": "Agent Maestro"
      },
      {
        "command": "agent-maestro.configureGeminiCli",
        "title": "Configure Gemini CLI Settings",
        "category": "Agent Maestro"
      },
      {
        "command": "agent-maestro.configureWorkBuddy",
        "title": "Select Fallback Model",
        "category": "Agent Maestro"
      },
      {
        "command": "agent-maestro.setLlmApiKey",
        "title": "Set LLM API Key",
        "category": "Agent Maestro"
      },
      {
        "command": "agent-maestro.setExaApiKey",
        "title": "Set Exa API Key",
        "category": "Agent Maestro"
      },
      {
        "command": "agent-maestro.openUsageDashboard",
        "title": "Open Usage Dashboard",
        "category": "Agent Maestro",
        "icon": "$(graph)"
      }
    ]
  },
  "activationEvents": [
    "onLanguage",
    "onStartupFinished"
  ],
  "dependencies": {
    "@anthropic-ai/sdk": "^0.96.0",
    "@google/genai": "^1.29.1",
    "@hono/node-server": "^1.17.1",
    "@hono/zod-openapi": "^1.0.2",
    "@roo-code/types": "^1.86.0",
    "es-toolkit": "^1.39.3",
    "fastmcp": "^3.5.0",
    "hono": "^4.8.9",
    "image-size": "^2.0.4",
    "openai": "^6.46.0",
    "smol-toml": "^1.6.0",
    "zod": "^4.0.10"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.4",
    "@trivago/prettier-plugin-sort-imports": "^5.2.2",
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@types/vscode": "^1.120.0",
    "@typescript-eslint/eslint-plugin": "^8.31.1",
    "@typescript-eslint/parser": "^8.31.1",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.7.0",
    "esbuild": "^0.25.3",
    "eslint": "^9.25.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.0",
    "npm-run-all": "^4.1.5",
    "ovsx": "^0.10.4",
    "prettier": "3.5.3",
    "rimraf": "^6.0.1",
    "typescript": "^5.8.3"
  },
  "scripts": {
    "vscode:prepublish": "pnpm run build:prod",
    "vscode:package": "vsce package --no-dependencies",
    "publish:vs-marketplace": "vsce publish --no-dependencies",
    "publish:open-vsx": "ovsx publish --no-dependencies",
    "build": "pnpm run check-types && pnpm run lint && node esbuild.js",
    "build:prod": "rimraf dist && pnpm run check-types && pnpm run lint && node esbuild.js --production",
    "build-tests": "tsc -p tsconfig.test.json && node -e \"require('fs').writeFileSync('out/package.json','{\\\"type\\\":\\\"commonjs\\\"}')\"",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "watch-tests": "tsc -p tsconfig.test.json -w",
    "pretest": "pnpm run build-tests && pnpm run build && pnpm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test",
    "smoke:vision": "node --experimental-strip-types scripts/test-vision.ts --all-image-types",
    "prepare": "husky",
    "changeset": "changeset",
    "changeset:version": "pnpm changeset version && node .changeset/changelog-polish.js",
    "changeset:tag": "changeset tag",
    "mcp-inspector": "npx @modelcontextprotocol/inspector"
  },
  "lint-staged": {
    "**/*": "prettier --write --ignore-unknown"
  }
}
